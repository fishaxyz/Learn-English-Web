{
  "name": "english-skills",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "codegen": "pnpm --filter @english/graphql codegen",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "docker:up": "pnpm -s docker:prune-cache && docker compose -f infrastructure/docker-compose.yml --env-file .env up --build --wait",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml --env-file .env down",
    "docker:logs": "docker compose -f infrastructure/docker-compose.yml --env-file .env logs -f",
    "docker:ps": "docker compose -f infrastructure/docker-compose.yml --env-file .env ps",
    "docker:seed": "docker compose -f infrastructure/docker-compose.yml --env-file .env run --rm -e NODE_ENV=development api node dist/seed.js",
    "db:migrate": "pnpm --filter @english/database db:migrate",
    "db:seed": "pnpm --filter @english/api seed",
    "docker:invite": "docker compose -f infrastructure/docker-compose.yml --env-file .env run --rm api node dist/invite.js",
    "invite": "pnpm --filter @english/api invite",
    "e2e": "playwright test",
    "docker:prune-cache": "docker builder prune -f --max-used-space 8gb >/dev/null",
    "docker:trim": "colima ssh -- sudo fstrim -av"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7"
  }
}
