# Copy to .env for local development (never commit .env). Placeholders only: no real values here.
# Each service reads only what it needs.

# --- API (apps/api) ---
DATABASE_URL=postgres://english:english@localhost:5434/english
API_PORT=4400
CORS_ORIGINS=
LOG_LEVEL=info
# The site a request is for when it doesn't name one (x-site-domain). The seed creates it.
DEFAULT_SITE_DOMAIN=localhost
# Set to 1 for one JSON object per log line.
LOG_JSON=

# Tests: a server where throwaway databases (test_*) are created and dropped. Never production.
TEST_DATABASE_URL=postgres://english:change-me-local-only@localhost:5434/postgres

# --- Website and dashboard (server-side only; never NEXT_PUBLIC_) ---
GRAPHQL_API_URL=http://localhost:4400
# The site this website shows (sent to the API), and its public address for links and the sitemap.
SITE_DOMAIN=localhost
SITE_URL=http://localhost:3400
# Shared by the API and the website: the API uses it to ask for cached pages to be refreshed after a publish.
# At least 32 characters. Generate one, e.g.: openssl rand -base64 32
REVALIDATION_SECRET=

# --- Dashboard sign-in (Auth.js) ---
# At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=
# development: sign-in links are written to .dev-mailbox/ instead of being emailed. production needs EMAIL_SERVER.
APP_ENV=development
# SMTP for sign-in emails, e.g. smtps://user:pass@smtp.example.com:465 (any provider's free tier works).
EMAIL_SERVER=
EMAIL_FROM=English Skills <no-reply@localhost>
WEBSITE_URL=http://localhost:3400
# Google sign-in (optional): an OAuth client from Google Cloud. See docs/google-sign-in.md. Never commit real values.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Python worker (services/python-engine) ---
# GRAPHQL_API_URL above is shared.
WORKER_POLL_INTERVAL_SECONDS=10

# --- Docker Compose only ---
POSTGRES_USER=english
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=english
